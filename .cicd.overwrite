---

# Generic
generic:
  role: php
  role_short: php
  role_description: |
    Manages php

# Supported platforms
platforms:
  ubuntu2004:
    supported: true
    ci: true
  fedora43:
    supported: false
    ci: false
  fedora44:
    supported: false
    ci: false

molecule:
  requirements:
    roles_extra:
      - deitkrachten.apache
      - deitkrachten.openssl
  converge:
    roles:
      - deitkrachten.openssl
      - deitkrachten.apache
    vars:
      openssl_fqdn: server.example.com
      apache_fqdn: server.example.com
      apache_ssl_key: "{{ openssl_server_key }}"
      apache_ssl_crt: "{{ openssl_server_crt }}"
      apache_ssl_chain: "{{ openssl_server_crt }}"
